---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import IntroAnimation from '../components/IntroAnimation.astro';
import Hero from '../components/Hero.astro';
import BrailleShader from '../components/BrailleShader.astro';
import ShowreelCard from '../components/ShowreelCard.astro';
import HeroMeta from '../components/HeroMeta.astro';
import SecondPage from '../components/SecondPage.astro';
import ThirdPage from '../components/ThirdPage.astro';
import SelectedWorks from '../components/SelectedWorks.astro';
import '../styles/pages/home.css';
---

<BaseLayout
	title="Pramsu Pandey — Product Designer + Engineer"
	description="Pramsu Pandey is a product designer and engineer creating secure, resilient digital experiences."
>
	<IntroAnimation />
	<Navbar />
	<div class="scroll-experience" data-scroll-experience>
		<div class="scroll-stage" data-scroll-stage>
			<section class="page-shell" aria-label="Introduction">
				<div class="page-background" aria-hidden="true">
					<BrailleShader />
				</div>

				<main class="page-content">
					<Hero />
				</main>

				<p class="page-intro">
					Hi, I’m Pramsu, a product<br />
					designer that engineers. I design<br />
					digital experiences then make them<br />
					secure and resilient.
				</p>

				<HeroMeta />
			</section>

			<SecondPage />
			<ThirdPage />
			<ShowreelCard />
		</div>
	</div>

	<SelectedWorks />

	<script src="../scripts/scrollExperience.ts"></script>
</BaseLayout>
