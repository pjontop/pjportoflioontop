---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import IntroAnimation from '../components/IntroAnimation.astro';
import Hero from '../components/Hero.astro';
import BrailleShader from '../components/BrailleShader.astro';
import ShowreelCard from '../components/ShowreelCard.astro';
import HeroMeta from '../components/HeroMeta.astro';
import SecondPage from '../components/SecondPage.astro';
import ThirdPage from '../components/ThirdPage.astro';
import SelectedWorks from '../components/SelectedWorks.astro';
import { siteConfig } from '../data/site';
import '../styles/pages/home.css';
---

<BaseLayout
	title={siteConfig.title}
	description={siteConfig.description}
>
	<IntroAnimation />
	<Navbar />
	<main id="main-content">
		<div class="scroll-experience" data-scroll-experience>
			<div class="scroll-stage" data-scroll-stage>
				<section class="page-shell" aria-label="Introduction">
					<div class="page-background" aria-hidden="true">
						<BrailleShader />
					</div>

					<div class="page-content">
						<Hero />
					</div>

					<p class="page-intro">
						Hi, I’m Pramsu—an Ottawa product<br />
						designer and full-stack engineer. I turn<br />
						ambitious ideas into secure, resilient<br />
						digital products built to scale.
					</p>

					<HeroMeta />
				</section>

				<SecondPage />
				<ThirdPage />
				<ShowreelCard />
			</div>
		</div>

		<SelectedWorks />
	</main>

	<script src="../scripts/scrollExperience.ts"></script>
</BaseLayout>
