---
import Button from './Button.astro';
import MobileMenu from './MobileMenu.astro';
import { navigationItems } from '../data/site';
---

<header
	class="site-navbar"
	data-site-navbar
	data-compact="false"
	data-visible="true"
	data-foreground="porridge"
	aria-label="Site navigation"
>
	<a class="identity" href="#top" aria-label="Pramsu Pandey, back to top">
		<p class="name">PRAMSU PANDEY</p>
		<p class="role">PRODUCT DESIGNER + ENGINEER</p>
	</a>

	<nav class="primary-nav" aria-label="Primary navigation">
		<Button
			href="#showreel"
			label={'✦\u00a0\u00a0SHOWREEL'}
			ariaLabel="View selected work showreel"
		/>
	</nav>

	<nav class="page-nav" aria-label="Portfolio navigation">
		<Button href="#works" label="WORKS" ariaLabel="View selected works" />
		<Button href="#process" label="PROCESS" ariaLabel="View design and engineering process" />
		<Button href="#contact" label="CONTACT" ariaLabel="Go to contact section" />
	</nav>

	<div class="staggered-menu-host">
		<MobileMenu items={navigationItems} />
	</div>

	<nav class="mobile-gpt" aria-label="Showreel navigation">
		<Button
			href="#showreel"
			label="✦"
			variant="floating"
			ariaLabel="View selected work showreel"
		/>
	</nav>
</header>

<style>
	.site-navbar {
		position: fixed;
		top: 1.4375rem;
		left: var(--page-gutter);
		right: var(--page-gutter);
		z-index: 100;
		display: flex;
		align-items: center;
		justify-content: space-between;
		color: var(--color-porridge);
		font-size: 14px;
		font-style: normal;
		font-weight: var(--font-weight-medium);
		line-height: 100%;
		letter-spacing: -0.015em;
		transform: translate3d(0, 0, 0);
		transition:
			color 220ms ease,
			opacity 280ms ease,
			transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
		will-change: color, opacity, transform;
	}

	.staggered-menu-host :global(.mobile-menu[data-open] .mobile-menu__toggle) {
		color: var(--color-blueberry) !important;
	}

	.site-navbar[data-visible="false"] {
		opacity: 0;
		transform: translate3d(0, calc(-100% - 2rem), 0);
		pointer-events: none;
	}

	.identity,
	.page-nav {
		display: flex;
		align-items: center;
	}

	.identity {
		gap: 2.4375rem;
		color: inherit;
		text-decoration: none;
	}

	.name,
	.role {
		margin: 0;
		white-space: nowrap;
	}

	.role {
		color: inherit;
		opacity: 0.72;
	}

	.primary-nav {
		position: absolute;
		left: 50%;
		transform: translateX(-50%);
	}

	.page-nav {
		gap: 2rem;
		margin-left: auto;
	}

	.staggered-menu-host,
	.mobile-gpt {
		display: none;
	}

	.site-navbar[data-compact="true"] .identity {
		gap: clamp(0.75rem, 3vw, 1.5rem);
	}

	.site-navbar[data-compact="true"] .primary-nav,
	.site-navbar[data-compact="true"] .page-nav {
		visibility: hidden;
		pointer-events: none;
	}

	.site-navbar[data-compact="true"] .staggered-menu-host,
	.site-navbar[data-compact="true"] .mobile-gpt {
		display: block;
	}

	@media (max-width: 47.99rem) {
		.site-navbar {
			top: 1.5rem;
		}

		.mobile-gpt :global(.text-button--floating) {
			top: 1rem;
			right: 4.25rem;
			bottom: auto;
		}
	}

	@media (max-width: 31.25rem) {
		.role {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-navbar {
			transition: color 120ms linear;
		}
	}
</style>

<script src="../scripts/navbar.ts"></script>
