---
import asciiArtwork from '../shaders/ascii1.svg';
---

<img
	class="braille-shader"
	src={asciiArtwork.src}
	alt=""
	width={asciiArtwork.width}
	height={asciiArtwork.height}
	decoding="async"
/>

<style>
	.braille-shader {
		position: absolute;
		top: 9.1875rem;
		left: -1.9375rem;
		display: block;
		width: 80rem;
		height: auto;
		max-width: none;
	}

	@media (max-width: 47.99rem) {
		.braille-shader {
			top: 7.5rem;
			left: -12rem;
			width: 60rem;
		}
	}
</style>
