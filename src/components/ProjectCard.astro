---
interface Props {
	tall?: boolean;
	title: string;
	status?: string;
}

const {
	tall = false,
	title,
	status = 'Coming soon',
} = Astro.props;
---

<article class:list={['project-card', { 'project-card--tall': tall }]}>
	<div class="project-card__media" aria-hidden="true"></div>
	<div class="project-card__meta">
		<h3>{title}</h3>
		<p>{status}</p>
	</div>
</article>

<style>
	.project-card + .project-card {
		margin-top: 0.75rem;
	}

	.project-card__media {
		height: 22.6875rem;
		border-radius: var(--radius-md);
		background: var(--color-porridge);
	}

	.project-card--tall .project-card__media {
		height: 32.4375rem;
	}

	.project-card__meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-top: 0.75rem;
		font-size: 0.8125rem;
		font-weight: var(--font-weight-semibold);
		line-height: 1;
		letter-spacing: -0.0203125rem;
	}

	.project-card__meta h3,
	.project-card__meta p {
		margin: 0;
		font: inherit;
		white-space: nowrap;
	}

	@media (max-width: 47.99rem) {
		.project-card + .project-card {
			margin-top: 0.75rem;
		}

		.project-card__media,
		.project-card--tall .project-card__media {
			height: var(--mobile-card-height);
		}

		.project-card__meta {
			font-size: 0.625rem;
		}
	}
</style>
