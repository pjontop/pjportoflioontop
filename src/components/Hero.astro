---
import MarqueeStrip from './MarqueeStrip.astro';

const marqueeWords = ['ENGINEERING', 'DESIGN', 'SECURITY', 'SCALE'];
---

<section class="hero" aria-labelledby="hero-title">
	<div class="hero__signature-stage">
		<h1 id="hero-title" class="hero__title">
			<span class="hero__title-text">Pramsu Pandey</span>
			<img
				class="hero__signature"
				src="/pramsuSignature.svg"
				alt=""
				width="1280"
				height="307"
				fetchpriority="high"
			/>
		</h1>

		<div class="hero__marquee">
			<MarqueeStrip words={marqueeWords} />
		</div>
	</div>
</section>

<style>
	.hero {
		padding-top: clamp(5rem, 3.25rem + 7.5vw, 7.81rem);
	}

	.hero__signature-stage {
		position: relative;
	}

	.hero__title {
		margin: 0;
	}

	.hero__title-text {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.hero__signature {
		display: block;
		width: 100%;
		height: auto;
	}

	.hero__marquee {
		position: absolute;
		/* Keep the strip attached to the same point on the responsive signature. */
		top: 74.5928%;
		left: 50%;
		z-index: 1;
		transform: translateX(-50%);
	}

	@media (max-width: 47.99rem) {
		.hero {
			padding-top: 6rem;
		}

		.hero__signature-stage {
			height: 15.25rem;
		}

		.hero__signature {
			position: absolute;
			top: 0;
			left: 50%;
			width: 46rem;
			max-width: none;
			transform: translateX(-50%);
		}

		.hero__marquee {
			top: 10.75rem;
		}
	}
</style>
