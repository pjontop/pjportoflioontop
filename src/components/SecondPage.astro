---

<section
	class="process-page"
	data-process-page
	data-selection-theme="porridge"
	aria-labelledby="process-heading"
>
	<h2 id="process-heading" class="sr-only">
		I turn a messy idea into a scalable site that works.
	</h2>

	<div class="process-marquee" data-process-marquee aria-label="Areas of expertise">
		<img class="process-marquee__line" src="/process-line.svg" alt="" />
		<div class="process-marquee__viewport">
			<div class="process-marquee__track" data-process-marquee-track>
				{marqueeGroups.map((group, groupIndex) => (
					<div
						class="process-marquee__group"
						data-process-marquee-group={groupIndex === 0 ? '' : undefined}
						aria-hidden="true"
					>
						{group.map((item) => (
							<span class="process-marquee__pair">
								<span>{item}</span>
								<span class="process-marquee__star">✦</span>
							</span>
						))}
					</div>
				))}
			</div>
		</div>
		<img class="process-marquee__line process-marquee__line--bottom" src="/process-line.svg" alt="" />
	</div>

	<div class="process-figure process-figure--top" data-process-art aria-hidden="true">
		<pre>{topFigure}</pre>
	</div>

	<div class="process-copy process-copy--left" data-split-copy aria-hidden="true">
		<span class="process-copy__line">I turn a</span>
		<span class="process-copy__line">messy idea,</span>
		<span class="process-copy__line process-copy__line--serif">into a</span>
	</div>

	<div class="process-copy process-copy--right" data-split-copy aria-hidden="true">
		<span class="process-copy__line">scalable</span>
		<span class="process-copy__line">site that</span>
		<span class="process-copy__line process-copy__line--serif">works.</span>
	</div>

	<div class="process-figure process-figure--bottom" data-process-art aria-hidden="true">
		<pre>{bottomFigure}</pre>
	</div>
</section>

<style>
	.process-page {
		position: absolute;
		inset: 0;
		z-index: 5;
		height: 100%;
		overflow: hidden;
		background: var(--color-paper);
		color: var(--color-blueberry);
		visibility: hidden;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.process-marquee {
		position: absolute;
		top: 4.625rem;
		left: 1.375rem;
		right: 1.75rem;
		height: 2.0625rem;
		overflow: hidden;
	}

	.process-marquee__line {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 1px;
		max-width: none;
	}

	.process-marquee__line--bottom {
		top: auto;
		bottom: 0;
	}

	.process-marquee__viewport,
	.process-marquee__track,
	.process-marquee__group,
	.process-marquee__pair {
		display: flex;
		align-items: center;
		height: 100%;
	}

	.process-marquee__viewport {
		overflow: hidden;
	}

	.process-marquee__track {
		width: max-content;
		will-change: transform;
	}

	.process-marquee__group {
		flex: none;
	}

	.process-marquee__pair {
		flex: 0 0 17.75rem;
		justify-content: space-between;
		padding-inline: 0.4375rem 0.25rem;
		font-family: "Manrope", system-ui, sans-serif;
		font-size: 0.8125rem;
		font-weight: 600;
		line-height: 1;
		letter-spacing: -0.0203rem;
		white-space: nowrap;
	}

	.process-marquee__star {
		font-size: 0.875rem;
	}

	.process-copy {
		position: absolute;
		z-index: 2;
		width: 33.5625rem;
		font-family: "Manrope", system-ui, sans-serif;
		font-size: 6.125rem;
		font-weight: 600;
		line-height: 0.995;
		letter-spacing: -0.1531rem;
	}

	.process-copy--left {
		top: 15.25rem;
		left: 1.4375rem;
	}

	.process-copy--right {
		top: 26.375rem;
		left: 66.09375%;
	}

	.process-copy__line {
		display: block;
		width: max-content;
		max-width: 100%;
	}

	.process-copy__line--serif {
		font-family: "Magilio Slant", "Iowan Old Style", "Baskerville", serif;
		font-style: normal;
		font-weight: 400;
		letter-spacing: inherit;
	}

	.process-figure {
		position: absolute;
		z-index: 1;
		color: var(--color-blueberry);
		font-family: "Manrope", system-ui, sans-serif;
		font-size: 1.25rem;
		font-weight: 600;
		line-height: 1;
		letter-spacing: -0.03125rem;
		white-space: pre;
	}

	.process-figure pre {
		margin: 0;
		font: inherit;
	}

	.process-figure--top {
		top: 8.0625rem;
		left: 45.9375%;
		transform: rotate(180deg);
	}

	.process-figure--bottom {
		top: 27.9375rem;
		left: -3.9375rem;
	}

	@media (max-width: 47.99rem) {
		.process-marquee {
			left: 1.5rem;
			right: 1.5rem;
		}

		.process-marquee__pair {
			flex-basis: 13.5rem;
		}

		.process-copy {
			right: 1.5rem;
			left: 1.5rem;
			width: auto;
			font-size: clamp(3.25rem, 15vw, 5rem);
			letter-spacing: -0.08rem;
		}

		.process-copy--left {
			top: 9.75rem;
		}

		.process-copy--right {
			top: auto;
			bottom: 3rem;
			text-align: right;
		}

		.process-copy--right .process-copy__line {
			margin-left: auto;
		}

		.process-copy__line--serif {
			letter-spacing: inherit;
		}

		.process-figure {
			font-size: 1rem;
			opacity: 0.75;
		}

		.process-figure--top {
			top: 8.5rem;
			left: 34%;
		}

		.process-figure--bottom {
			top: 28rem;
			left: -15rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.process-page {
			position: relative;
			min-height: max(100svh, 52rem);
			visibility: visible;
		}

		.process-marquee__track {
			will-change: auto;
		}
	}
</style>
