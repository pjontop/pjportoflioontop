---
interface Props {
	href: string;
	label: string;
	class?: string;
	variant?: 'text' | 'floating';
	ariaLabel: string;
}

const {
	href,
	label,
	class: className,
	variant = 'text',
	ariaLabel,
} = Astro.props;
---

<a
	class:list={[
		"text-button",
		{ "text-button--floating": variant === 'floating' },
		className,
	]}
	href={href}
	aria-label={ariaLabel}
>
	<span class="text-button__label">{label}</span>
</a>

<style>
	.text-button {
		position: relative;
		display: inline-flex;
		align-items: center;
		color: inherit;
		text-decoration: none;
		white-space: nowrap;
	}

	.text-button::after {
		position: absolute;
		right: 0;
		bottom: -0.3rem;
		left: 0;
		height: 1px;
		background: currentColor;
		content: "";
		transform: scaleX(0);
		transform-origin: right;
		transition: transform 180ms ease;
	}

	.text-button:hover::after,
	.text-button:focus-visible::after {
		transform: scaleX(1);
		transform-origin: left;
	}

	.text-button:focus-visible {
		border-radius: 0.125rem;
		outline: 2px solid currentColor;
		outline-offset: 0.35rem;
	}

	.text-button--floating {
		position: fixed;
		right: 1rem;
		bottom: 1rem;
		z-index: 20;
		display: grid;
		place-items: center;
		width: 3rem;
		height: 3rem;
		padding: 0;
		border: 1px solid color-mix(in srgb, var(--floating-button-fg, var(--color-blueberry)) 28%, transparent);
		border-radius: 50%;
		background: var(--floating-button-bg, var(--color-porridge));
		box-shadow: 0 0.5rem 1.5rem rgb(3 2 96 / 24%);
		color: var(--floating-button-fg, var(--color-blueberry));
		font-size: 1.5rem;
		line-height: 1;
		transform-origin: center;
		transition:
			transform 180ms ease,
			box-shadow 180ms ease,
			background-color 180ms ease,
			color 180ms ease,
			border-color 180ms ease;
	}

	.text-button--floating .text-button__label {
		display: grid;
		place-items: center;
		width: 1em;
		height: 1em;
		line-height: 1;
	}

	.text-button--floating::after {
		display: none;
	}

	.text-button--floating:hover {
		box-shadow: 0 0.65rem 1.75rem rgb(3 2 96 / 32%);
		transform: scale(1.04);
	}

	.text-button--floating:active {
		box-shadow: 0 0.3rem 0.9rem rgb(3 2 96 / 20%);
		transform: scale(0.9);
	}

	.text-button--floating:focus-visible {
		border-radius: 50%;
	}

	@media (prefers-reduced-motion: reduce) {
		.text-button::after,
		.text-button--floating {
			transition: none;
		}
	}
</style>

<script>
	const PORRIDGE = '#ffffff';
	const BLUEBERRY = '#371bff';

	const parseRgb = (color: string) => {
		const channels = color.match(/[\d.]+/g)?.map(Number);
		if (!channels || channels.length < 3) return null;

		return {
			r: channels[0],
			g: channels[1],
			b: channels[2],
			a: channels[3] ?? 1,
		};
	};

	const backgroundBehind = (button: HTMLElement) => {
		const bounds = button.getBoundingClientRect();
		const x = bounds.left + bounds.width / 2;
		const y = bounds.top + bounds.height / 2;
		const ignored = new Set([button, ...button.querySelectorAll('*')]);

		for (const element of document.elementsFromPoint(x, y)) {
			if (ignored.has(element) || button.parentElement?.contains(element)) continue;

			let current: Element | null = element;
			while (current) {
				const color = parseRgb(getComputedStyle(current).backgroundColor);
				if (color && color.a > 0.05) return color;
				current = current.parentElement;
			}
		}

		return parseRgb(getComputedStyle(document.body).backgroundColor);
	};

	const isLight = ({ r, g, b }: { r: number; g: number; b: number }) => {
		const linearize = (channel: number) => {
			const value = channel / 255;
			return value <= 0.04045
				? value / 12.92
				: ((value + 0.055) / 1.055) ** 2.4;
		};

		return (
			0.2126 * linearize(r) +
			0.7152 * linearize(g) +
			0.0722 * linearize(b)
		) > 0.45;
	};

	const updateFloatingButtons = () => {
		document.querySelectorAll<HTMLElement>('.text-button--floating').forEach((button) => {
			const background = backgroundBehind(button);
			const useBlueberry = !background || isLight(background);

			button.style.setProperty('--floating-button-bg', useBlueberry ? BLUEBERRY : PORRIDGE);
			button.style.setProperty('--floating-button-fg', useBlueberry ? PORRIDGE : BLUEBERRY);
		});
	};

	let animationFrame = 0;
	const requestUpdate = () => {
		cancelAnimationFrame(animationFrame);
		animationFrame = requestAnimationFrame(updateFloatingButtons);
	};

	requestUpdate();
	document.fonts.ready.then(requestUpdate);
	window.addEventListener('scroll', requestUpdate, { passive: true });
	window.addEventListener('resize', requestUpdate, { passive: true });
</script>
